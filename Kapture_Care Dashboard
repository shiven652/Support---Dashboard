      <td class="num">${r.pending?fmt(r.pending):'<span class="dash">0</span>'}</td>${sc(r.frtPct)}${sc(r.artPct)}
      <td class="num">${r.csat??'<span class="dash">—</span>'}</td></tr>`;}).join("");
  $("#agHint").textContent=`${rows.length} agents · ${fmt(DATA.length)} tickets`;}
function renderTrendChart(rows){
  const max=Math.max(1,...rows.map(o=>o.t));
