function uniq(idx){return [...new Set(RAW.map(r=>r[idx]).filter(v=>v!==""&&v!=null))];}
function customerOptions(){
  const src = state.fPod==="All" ? RAW : RAW.filter(r=>r[I.POD]===state.fPod);
  return [...new Set(src.map(r=>r[I.CUST]).filter(Boolean))];
}
function fillSelect(id,vals,sort){const el=$(id);const o=sort?vals.sort(sort):vals.sort();
  el.innerHTML='<option value="All">All</option>'+o.map(v=>`<option>${v}</option>`).join("");}
function buildFilters(){
  fillSelect("#fPod",uniq(I.POD));
