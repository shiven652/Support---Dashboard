      <div class="pt">${fmt(o.t)} tickets · ${pct(o.res,o.t)??0}% resolved</div>
      <div class="metric"><span class="ml">FRT within SLA</span><span class="mr ${slaClass(fp)}">${fp??'—'}%</span></div>${bar(fp,'var(--teal)')}
      <div class="metric" style="margin-top:9px"><span class="ml">ART within SLA</span><span class="mr ${slaClass(ap)}">${ap??'—'}%</span></div>${bar(ap,'var(--amber)')}</div>`;}).join("");}

function gauge(el,p,within,total,label,col){const r=54,c=2*Math.PI*r,off=c*(1-(p||0)/100);
  $(el).innerHTML=`<svg viewBox="0 0 140 140"><circle cx="70" cy="70" r="${r}" fill="none" stroke="#eef2f7" stroke-width="14"/>
    <circle cx="70" cy="70" r="${r}" fill="none" stroke="${col}" stroke-width="14" stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${off}" transform="rotate(-90 70 70)" style="transition:stroke-dashoffset .9s cubic-bezier(.2,.7,.2,1)"/>
    <text x="70" y="66" text-anchor="middle" font-family="IBM Plex Mono" font-weight="700" font-size="24" fill="var(--ink)">${p??0}%</text>
    <text x="70" y="86" text-anchor="middle" font-size="10" fill="#94a3b8">within SLA</text></svg>
    <div class="gl">${label}</div><div class="gd">${fmt(within)} of ${fmt(total)} tickets</div>`;}
function renderSLA(){const m=metrics(DATA);gauge("#frtGauge",m.frtPct,m.fN,m.fD,"First Response Time","var(--teal)");gauge("#artGauge",m.artPct,m.aN,m.aD,"Avg Resolution Time","var(--amber)");}

function render(){applyFilters();renderKPIs();renderTrend();renderAgentTable();renderCategoryBars();renderAccountBars();renderPods();renderSLA();$("#rowCount").textContent=fmt(RAW.length);}

function bind(){
  $("#fPod").onchange=e=>{state.fPod=e.target.value;state.fCustomer="All";fillSelect("#fCustomer",customerOptions());render();};
  $("#fCustomer").onchange=e=>{state.fCustomer=e.target.value;render();};
  $("#fMonth").onchange=e=>{state.fMonth=e.target.value;render();};
  $("#fSub").onchange=e=>{state.fSub=e.target.value;render();};
  $("#fFrom").onchange=e=>{state.from=e.target.value;render();};
  $("#fTo").onchange=e=>{state.to=e.target.value;render();};
  $("#modeInc").onclick=()=>setMode("include");$("#modeExc").onclick=()=>setMode("exclude");
  function setMode(m){state.mode=m;$("#modeInc").classList.toggle("on",m==="include");
    $("#modeExc").classList.toggle("on",m==="exclude");$("#modeExc").classList.toggle("exc",m==="exclude");render();}
  $("#resetBtn").onclick=()=>{Object.assign(state,{fPod:"All",fCustomer:"All",fMonth:"All",fSub:"All",from:"",to:""});
    buildFilters();$("#fFrom").value="";$("#fTo").value="";render();};
  $("#refreshBtn").onclick=loadLive;
  $("#granSeg").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;
    state.gran=b.dataset.g;[...$("#granSeg").children].forEach(x=>x.classList.toggle("on",x===b));renderTrend();});
  $("#agTable thead").addEventListener("click",e=>{const th=e.target.closest("th");if(!th||!th.dataset.k)return;
    const k=th.dataset.k;if(sortState.key===k)sortState.dir*=-1;else{sortState.key=k;sortState.dir=(k==="agent"||k==="pod")?1:-1;}renderAgentTable();});
}

/* ---- live CSV ---- */
function parseCSV(t){const rows=[];let row=[],f="",q=false;
  for(let i=0;i<t.length;i++){const c=t[i];
    if(q){if(c==='"'){if(t[i+1]==='"'){f+='"';i++;}else q=false;}else f+=c;}
    else{if(c==='"')q=true;else if(c===','){row.push(f);f="";}
      else if(c==='\n'){row.push(f);rows.push(row);row=[];f="";}
      else if(c==='\r'){}else f+=c;}}
  if(f.length||row.length){row.push(f);rows.push(row);}return rows;}
const slaVal=v=>{if(v==null)return null;const s=String(v).toLowerCase();return s.includes("within")?1:(s.includes("out")?0:null);};
const numVal=v=>{const n=parseFloat(v);return isNaN(n)?null:n;};
function dateVal(v){if(!v)return"";const s=String(v).trim();
  let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return`${m[1]}-${m[2]}-${m[3]}`;
  m=s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})/);if(m){const i=MON.findIndex(x=>x.toLowerCase()===m[2].toLowerCase());if(i>=0)return`${m[3]}-${String(i+1).padStart(2,'0')}-${m[1].padStart(2,'0')}`;}
  m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);if(m)return`${m[3]}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`;
  return"";}
function mapLive(rows){const head=rows[0].map(h=>h.trim());const ix=n=>head.indexOf(n);
  const c={agent:ix(CONFIG.agentField),pod:ix("POD Account"),cust:ix("Customer Name"),status:ix("Status"),sub:ix("Sub Status"),sev:ix("Severity"),frt:ix("FRT (In Mins)"),art:ix("ART (In Mins)"),frtS:ix("FRT (SLA)"),artS:ix("ART (SLA)"),csat:ix("Customer Rating"),month:ix("Create Month"),date:ix("Create Date"),cat:ix("Disposition Folder Level 3"),id:ix("Ticket ID")};
  const out=[];for(let i=1;i<rows.length;i++){const r=rows[i];if(!r[c.id]||!String(r[c.id]).trim())continue;
    out.push([(r[c.agent]||"").trim()||"Unassigned",(r[c.pod]||"").trim(),(r[c.cust]||"").trim(),(r[c.status]||"").trim(),(r[c.sub]||"").trim(),(r[c.sev]||"").trim(),numVal(r[c.frt]),numVal(r[c.art]),slaVal(r[c.frtS]),slaVal(r[c.artS]),numVal(r[c.csat]),(r[c.month]||"").trim(),dateVal(r[c.date]),(r[c.cat]||"").trim()||"Uncategorized"]);}
  return out;}
async function loadLive(){if(!CONFIG.csvUrl){flashUpdated();return;}
  $("#refreshBtn").textContent="↻ Loading…";
  try{const res=await fetch(CONFIG.csvUrl,{cache:"no-store"});const txt=await res.text();const mapped=mapLive(parseCSV(txt));
    if(mapped.length){RAW=mapped;buildFilters();$("#liveTag").className="live-tag live";$("#liveTag").textContent="Live";$("#srcDesc").textContent="Published Google Sheet (NT-Dump)";}
    render();flashUpdated();
  }catch(e){$("#srcDesc").textContent="Live fetch failed — showing snapshot";console.error(e);}
  $("#refreshBtn").textContent="↻ Refresh now";}
function flashUpdated(){$("#updTime").textContent=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});}

buildFilters();bind();render();flashUpdated();
if(CONFIG.csvUrl){loadLive();setInterval(loadLive,CONFIG.refreshMinutes*60000);}
</script>
