  fillSelect("#fMonth",uniq(I.MONTH),(a,b)=>MONTH_ORDER.indexOf(a)-MONTH_ORDER.indexOf(b));
  fillSelect("#fSub",uniq(I.SUB));
  $("#fPod").value=state.fPod;$("#fCustomer").value=state.fCustomer;$("#fMonth").value=state.fMonth;$("#fSub").value=state.fSub;
}
function applyFilters(){
  const cats=[[I.POD,state.fPod],[I.CUST,state.fCustomer],[I.MONTH,state.fMonth],[I.SUB,state.fSub]];
  DATA=RAW.filter(r=>{
    if(state.from && (!r[I.DATE]||r[I.DATE]<state.from)) return false;
    if(state.to && (!r[I.DATE]||r[I.DATE]>state.to)) return false;
    const active=cats.filter(c=>c[1]!=="All");
    if(!active.length) return true;
    const m=active.map(c=>r[c[0]]===c[1]);
    return state.mode==="include"?m.every(Boolean):!m.some(Boolean);
  });
}

function metrics(rows){let total=rows.length,res=0,pen=0,fN=0,fD=0,aN=0,aD=0,cS=0,cC=0;
  for(const r of rows){r[I.STATUS]==="Complete"?res++:pen++;
    if(r[I.FRTSLA]!==null){fD++;if(r[I.FRTSLA]===1)fN++;}
    if(r[I.ARTSLA]!==null){aD++;if(r[I.ARTSLA]===1)aN++;}
    if(r[I.CSAT]!=null){cS+=r[I.CSAT];cC++;}}
  return{total,res,pen,fN,fD,aN,aD,frtPct:pct(fN,fD),artPct:pct(aN,aD),resPct:pct(res,total),
    csat:cC?Math.round(cS/cC*100)/100:null,cC};}

function renderKPIs(){const m=metrics(DATA);
  const c=[{l:"Total Tickets",v:fmt(m.total),s:"All assigned",c:"var(--navy)"},
    {l:"Resolved",v:fmt(m.res),s:`${m.resPct??0}% resolution`,c:"var(--emerald)"},
    {l:"Open / Pending",v:fmt(m.pen),s:`${pct(m.pen,m.total)??0}% backlog`,c:"var(--red)"},
    {l:"FRT within SLA",v:(m.frtPct??0)+"%",s:`${fmt(m.fN)} / ${fmt(m.fD)}`,c:"var(--teal)"},
    {l:"ART within SLA",v:(m.artPct??0)+"%",s:`${fmt(m.aN)} / ${fmt(m.aD)}`,c:"var(--amber)"},
    {l:"Avg CSAT",v:m.csat??"—",s:`${fmt(m.cC)} rated`,c:"var(--violet)"}];
  $("#kpis").innerHTML=c.map((x,i)=>`<div class="kpi" style="--c:${x.c};animation-delay:${i*55}ms"><div class="lab">${x.l}</div><div class="val">${x.v}</div><div class="sub">${x.s}</div></div>`).join("");}

/* ---- trend (daily/weekly/monthly) ---- */
function mondayOf(iso){const [y,m,d]=iso.split('-').map(Number);const dt=new Date(Date.UTC(y,m-1,d));const wd=(dt.getUTCDay()+6)%7;dt.setUTCDate(dt.getUTCDate()-wd);return dt.toISOString().slice(0,10);}
const lblDM=iso=>{const p=iso.split('-');return (+p[2])+' '+MON[+p[1]-1];};
const lblMon=k=>{const p=k.split('-');return MON[+p[1]-1]+' '+p[0];};
function trend(g){const map=new Map();
  for(const r of DATA){const iso=r[I.DATE];if(!iso)continue;let key,label;
    if(g==="monthly"){key=iso.slice(0,7);label=lblMon(key);}
    else if(g==="weekly"){key=mondayOf(iso);label="Wk of "+lblDM(key);}
    else{key=iso;label=lblDM(iso);}
    if(!map.has(key))map.set(key,{key,label,t:0,res:0,pen:0,fN:0,fD:0,aN:0,aD:0,cS:0,cC:0});
    const o=map.get(key);o.t++;r[I.STATUS]==="Complete"?o.res++:o.pen++;
    if(r[I.FRTSLA]!==null){o.fD++;if(r[I.FRTSLA]===1)o.fN++;}
    if(r[I.ARTSLA]!==null){o.aD++;if(r[I.ARTSLA]===1)o.aN++;}
    if(r[I.CSAT]!=null){o.cS+=r[I.CSAT];o.cC++;}}
  return [...map.values()].sort((a,b)=>a.key<b.key?-1:1);}
function renderTrend(){
  const rows=trend(state.gran);
  renderTrendChart(rows);
  const cols=["Period","Tickets","Resolved","Pending","FRT SLA","ART SLA","CSAT"];
  $("#trTable thead").innerHTML="<tr>"+cols.map((c,i)=>`<th class="nocsort ${i?'num':''}">${c}</th>`).join("")+"</tr>";
  const cell=(n,d)=>{const p=pct(n,d);return p===null?'<td class="num"><span class="dash">—</span></td>':`<td class="num"><span class="${slaClass(p)}">${p}%</span></td>`;};
  $("#trTable tbody").innerHTML=rows.map(o=>`<tr>
    <td>${o.label}</td><td class="num">${fmt(o.t)}</td><td class="num">${fmt(o.res)}</td>
    <td class="num">${o.pen?fmt(o.pen):'<span class="dash">0</span>'}</td>
    ${cell(o.fN,o.fD)}${cell(o.aN,o.aD)}
    <td class="num">${o.cC?Math.round(o.cS/o.cC*100)/100:'<span class="dash">—</span>'}</td></tr>`).join("");
  const T=rows.reduce((a,o)=>{a.t+=o.t;a.res+=o.res;a.pen+=o.pen;a.fN+=o.fN;a.fD+=o.fD;a.aN+=o.aN;a.aD+=o.aD;a.cS+=o.cS;a.cC+=o.cC;return a;},{t:0,res:0,pen:0,fN:0,fD:0,aN:0,aD:0,cS:0,cC:0});
  $("#trTable tfoot").innerHTML=`<tr><td>Total · ${rows.length} ${state.gran.replace('ly','')+(rows.length!==1?'s':'')}</td>
    <td class="num">${fmt(T.t)}</td><td class="num">${fmt(T.res)}</td><td class="num">${fmt(T.pen)}</td>
    <td class="num">${pct(T.fN,T.fD)??'—'}%</td><td class="num">${pct(T.aN,T.aD)??'—'}%</td>
    <td class="num">${T.cC?Math.round(T.cS/T.cC*100)/100:'—'}</td></tr>`;
  $("#trHint").textContent=`${rows.length} period${rows.length!==1?'s':''}`;
}

/* ---- agents ---- */
function agentAgg(){const map=new Map();
  for(const r of DATA){const a=r[I.AGENT];if(!map.has(a))map.set(a,{agent:a,pods:{},tickets:0,resolved:0,pending:0,fN:0,fD:0,aN:0,aD:0,cS:0,cC:0});
    const o=map.get(a);o.tickets++;o.pods[r[I.POD]]=(o.pods[r[I.POD]]||0)+1;
    r[I.STATUS]==="Complete"?o.resolved++:o.pending++;
    if(r[I.FRTSLA]!==null){o.fD++;if(r[I.FRTSLA]===1)o.fN++;}
    if(r[I.ARTSLA]!==null){o.aD++;if(r[I.ARTSLA]===1)o.aN++;}
    if(r[I.CSAT]!=null){o.cS+=r[I.CSAT];o.cC++;}}
  return [...map.values()].map(o=>({agent:o.agent,pod:Object.entries(o.pods).sort((a,b)=>b[1]-a[1])[0][0]||"—",
    tickets:o.tickets,resolved:o.resolved,pending:o.pending,frtPct:pct(o.fN,o.fD),artPct:pct(o.aN,o.aD),
    csat:o.cC?Math.round(o.cS/o.cC*100)/100:null}));}
const COLS=[{k:"agent",l:"Agent"},{k:"pod",l:"POD"},{k:"tickets",l:"Tickets",num:1},{k:"resolved",l:"Resolved",num:1},{k:"pending",l:"Pending",num:1},{k:"frtPct",l:"FRT SLA",num:1},{k:"artPct",l:"ART SLA",num:1},{k:"csat",l:"CSAT",num:1}];
