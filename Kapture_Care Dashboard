  $("#agTable thead").innerHTML="<tr>"+COLS.map(c=>`<th class="${c.num?'num':''} ${c.k===key?'sorted':''}" data-k="${c.k}">${c.l}<span class="ar">${c.k===key?(dir>0?'▲':'▼'):'↕'}</span></th>`).join("")+"</tr>";
  $("#agTable tbody").innerHTML=rows.map(r=>{
    const sc=p=>p===null?'<td class="num"><span class="dash">—</span></td>':`<td class="num"><div class="slacell"><div class="mini"><i style="width:${p}%;background:${slaCol(p)}"></i></div><span class="${slaClass(p)}">${p}%</span></div></td>`;
    return `<tr><td><div class="agcell"><div class="av" style="background:${colorFor(r.agent)}">${initials(r.agent)}</div>${r.agent}</div></td>
