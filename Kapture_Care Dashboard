<header>
  <div class="hbar"></div>
  <div class="htop">
    <div class="brand">
      <div class="logo">🛠️</div>
      <div><h1>Kapture Care — Operations</h1><p>Live from Google Sheets · NT-Dump · auto-refreshes hourly</p></div>
    </div>
