    </div>
    <button class="btn primary" id="refreshBtn">↻ Refresh now</button>
  </div>

  <div class="filters">
    <div class="ftop">
      <span class="flabel">Filter mode</span>
      <div class="mode">
        <button id="modeInc" class="on" data-mode="include">✓ Include</button>
        <button id="modeExc" data-mode="exclude">✕ Exclude</button>
      </div>
    </div>
    <div class="frow">
      <div class="fld"><label>POD</label><select id="fPod"></select></div>
      <div class="fld"><label>Customer</label><select id="fCustomer"></select></div>
      <div class="fld"><label>Month</label><select id="fMonth"></select></div>
      <div class="fld"><label>Sub status</label><select id="fSub"></select></div>
      <div class="fld"><label>From</label><input type="date" id="fFrom"></div>
      <div class="fld"><label>To</label><input type="date" id="fTo"></div>
      <div class="fld resetfld"><button class="btn dark" id="resetBtn">Reset Filters</button></div>
    </div>
  </div>

  <div class="kpis" id="kpis"></div>

  <div class="section">
    <div class="sechead">
      <span class="bar"></span><h2>Trend over time</h2>
      <span class="hint" id="trHint"></span>
      <span class="spacer"></span>
      <div class="seg" id="granSeg">
        <button data-g="daily">Daily</button>
        <button data-g="weekly">Weekly</button>
        <button class="on" data-g="monthly">Monthly</button>
      </div>
    </div>
    <div class="panel">
      <div id="trChart" class="trchart"></div>
      <div class="tblwrap"><table id="trTable"><thead></thead><tbody></tbody><tfoot></tfoot></table></div>
    </div>
  </div>

  <div class="section">
    <div class="sechead"><span class="bar" style="background:var(--emerald);box-shadow:0 0 0 4px rgba(16,185,129,.18)"></span><h2>Volume breakdown</h2></div>
    <div class="grid2">
      <div class="panel"><h3>Tickets by category</h3><div class="ph">Issue · Query · Service Request · Enhancement …</div><div id="catBars"></div></div>
      <div class="panel"><h3>Top accounts by volume</h3><div class="ph">Tickets per customer (filtered)</div><div id="acctBars"></div></div>
    </div>
  </div>

  <div class="section">
    <div class="sechead"><span class="bar" style="background:var(--blue);box-shadow:0 0 0 4px rgba(59,130,246,.18)"></span><h2>Agent-wise distribution</h2><span class="hint" id="agHint"></span></div>
    <div class="panel">
      <h3>Performance by agent</h3>
      <div class="ph">Click any column to sort · SLA % = tickets meeting the FRT/ART target</div>
      <div class="tblwrap"><table id="agTable"><thead></thead><tbody></tbody></table></div>
    </div>
  </div>

  <div class="section">
    <div class="sechead"><span class="bar" style="background:var(--violet);box-shadow:0 0 0 4px rgba(124,108,240,.18)"></span><h2>POD-wise performance</h2></div>
    <div class="panel"><div class="pods" id="podCards"></div></div>
  </div>

  <div class="section">
    <div class="sechead"><span class="bar" style="background:var(--amber);box-shadow:0 0 0 4px rgba(245,158,11,.18)"></span><h2>FRT &amp; ART · SLA compliance</h2></div>
    <div class="panel">
      <div class="slagrid"><div class="gauge" id="frtGauge"></div><div class="gauge" id="artGauge"></div></div>
      <div class="legend"><span><i style="background:var(--emerald)"></i>Within SLA</span><span><i style="background:#e2e8f0"></i>Outside SLA</span></div>
    </div>
  </div>

  <div class="foot">Kapture Care Master Health Card · Operations view · built for the CX team</div>
</div>

